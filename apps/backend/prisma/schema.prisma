generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMERATIONS
// ----------------------------------------------------

enum UserRole {
  OWNER
  MANAGER
  WAITER
  KITCHEN
  CLEANER
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  PAYMENT_PENDING
  NEEDS_CLEANING
  CLEANING_IN_PROGRESS
  OUT_OF_SERVICE
}

enum SessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  IN_PROGRESS
  READY
  SERVED
  CANCELLED
}

enum ItemStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum BillStatus {
  OPEN
  PAID
  PARTIALLY_PAID
  VOID
}

enum PaymentMethod {
  UPI
  CARD
  WALLET
  CASH
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AlertType {
  CALL_WAITER
  REQUEST_BILL
  ORDER_DELAYED
  PAYMENT_FAILED
  LONG_WAIT
  UNATTENDED
  LONG_STAY
  HELP
  AI_SUGGESTION
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
  AI
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model Restaurant {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(150)
  slug       String   @unique @db.VarChar(80)
  address    String?  @db.Text
  phone      String?  @db.VarChar(20)
  gstin      String?  @db.VarChar(15)
  currency   String   @default("INR") @db.Char(3)
  timezone   String   @default("Asia/Kolkata") @db.VarChar(50)
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  users            User[]
  floors           Floor[]
  tables           Table[]
  tableSessions    TableSession[]
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  orders           Order[]
  tableAlerts      TableAlert[]
  auditLogs        AuditLog[]
  cameras          Camera[]

  @@map("restaurants")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String    @db.VarChar(120)
  email        String?   @db.VarChar(160)
  phone        String?   @db.VarChar(20)
  passwordHash String?   @map("password_hash") @db.Text
  pinHash      String?   @map("pin_hash") @db.Text
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shifts       StaffShift[]
  assignedAlerts TableAlert[] @relation("AssignedAlerts")
  assignedTasks  CleaningTask[] @relation("AssignedCleaningTasks")
  tablesCovered  Table[]      @relation("AssignedWaiterTables")
  placedOrders   Order[]      @relation("StaffPlacedOrders")
  refundsApproved Refund[]    @relation("RefundsApproved")

  @@unique([restaurantId, email])
  @@map("users")
}

model StaffShift {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  floorId         String?   @map("floor_id") @db.Uuid
  assignedTableIds String[] @default([]) @map("assigned_table_ids")
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime? @map("ends_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_shifts")
}

model Floor {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(80)
  sortOrder    Int      @default(0) @map("sort_order")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     Table[]
  cameras    Camera[]

  @@map("floors")
}

model Table {
  id               String      @id @default(uuid()) @db.Uuid
  restaurantId     String      @map("restaurant_id") @db.Uuid
  floorId          String      @map("floor_id") @db.Uuid
  label            String      @db.VarChar(20)
  capacity         Int         @db.SmallInt
  shape            String      @default("square") @db.VarChar(12)
  posX             Decimal     @default(0) @map("pos_x") @db.Decimal(10, 2)
  posY             Decimal     @default(0) @map("pos_y") @db.Decimal(10, 2)
  width            Decimal     @default(100) @db.Decimal(10, 2)
  height           Decimal     @default(100) @db.Decimal(10, 2)
  status           TableStatus @default(AVAILABLE)
  statusChangedAt  DateTime    @default(now()) @map("status_changed_at") @db.Timestamptz
  currentSessionId String?     @unique @map("current_session_id") @db.Uuid
  qrToken          String      @unique @map("qr_token") @db.VarChar(64)
  assignedWaiterId String?     @map("assigned_waiter_id") @db.Uuid
  isActive         Boolean     @default(true) @map("is_active")

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  floor          Floor          @relation(fields: [floorId], references: [id], onDelete: Cascade)
  assignedWaiter User?          @relation("AssignedWaiterTables", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  currentSession TableSession?  @relation("ActiveTableSession", fields: [currentSessionId], references: [id], onDelete: SetNull)
  sessions       TableSession[] @relation("AllTableSessions")
  alerts         TableAlert[]
  cleaningTasks  CleaningTask[]
  statusLogs     TableStatusLog[]
  cameraZones    CameraTableZone[]
  reservations   Reservation[]

  @@unique([restaurantId, label])
  @@index([restaurantId, floorId, status])
  @@map("tables")
}

model TableSession {
  id             String        @id @default(uuid()) @db.Uuid
  restaurantId   String        @map("restaurant_id") @db.Uuid
  tableId        String        @map("table_id") @db.Uuid
  status         SessionStatus @default(ACTIVE)
  openedBy       ActorType     @map("opened_by")
  guestCount     Int?          @map("guest_count") @db.SmallInt
  guestPhone     String?       @map("guest_phone") @db.VarChar(20)
  startedAt      DateTime      @default(now()) @map("started_at") @db.Timestamptz
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz
  lastActivityAt DateTime      @default(now()) @map("last_activity_at") @db.Timestamptz
  closeReason    String?       @map("close_reason") @db.VarChar(40)

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table          @relation("AllTableSessions", fields: [tableId], references: [id], onDelete: Cascade)
  activeFor  Table?         @relation("ActiveTableSession")
  orders     Order[]
  bill       Bill?
  alerts     TableAlert[]
  cleaningTasks CleaningTask[]
  feedback   Feedback[]

  @@index([tableId])
  @@map("table_sessions")
}

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(100)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String   @db.VarChar(150)
  description  String?  @db.Text
  price        Decimal  @db.Decimal(12, 2)
  taxRate      Decimal  @default(5.00) @map("tax_rate") @db.Decimal(5, 2)
  imageUrl     String?  @map("image_url") @db.Text
  isVeg        Boolean  @default(true) @map("is_veg")
  isAvailable  Boolean  @default(true) @map("is_available")
  prepTimeMin  Int      @default(15) @map("prep_time_min") @db.SmallInt
  tags         String[] @default([])
  sortOrder    Int      @default(0) @map("sort_order")

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants       ItemVariant[]
  modifierGroups ModifierGroup[]

  @@map("menu_items")
}

model ItemVariant {
  id     String  @id @default(uuid()) @db.Uuid
  itemId String  @map("item_id") @db.Uuid
  name   String  @db.VarChar(60)
  price  Decimal @db.Decimal(12, 2)

  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_variants")
}

model ModifierGroup {
  id        String @id @default(uuid()) @db.Uuid
  itemId    String @map("item_id") @db.Uuid
  name      String @db.VarChar(80)
  minSelect Int    @default(0) @map("min_select") @db.SmallInt
  maxSelect Int    @default(1) @map("max_select") @db.SmallInt

  item      MenuItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  modifiers Modifier[]

  @@map("modifier_groups")
}

model Modifier {
  id         String  @id @default(uuid()) @db.Uuid
  groupId    String  @map("group_id") @db.Uuid
  name       String  @db.VarChar(80)
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(12, 2)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("modifiers")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  restaurantId     String      @map("restaurant_id") @db.Uuid
  sessionId        String      @map("session_id") @db.Uuid
  tableId          String      @map("table_id") @db.Uuid
  orderNo          Int         @map("order_no")
  status           OrderStatus @default(PLACED)
  subtotal         Decimal     @db.Decimal(12, 2)
  taxTotal         Decimal     @map("tax_total") @db.Decimal(12, 2)
  discountTotal    Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  notes            String?     @db.Text
  placedByType     ActorType   @map("placed_by_type")
  placedByUserId   String?     @map("placed_by_user_id") @db.Uuid
  placedAt         DateTime    @default(now()) @map("placed_at") @db.Timestamptz

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  session      TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  placedByUser User?        @relation("StaffPlacedOrders", fields: [placedByUserId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@index([sessionId])
  @@index([restaurantId, placedAt])
  @@map("orders")
}

model OrderItem {
  id                String     @id @default(uuid()) @db.Uuid
  orderId           String     @map("order_id") @db.Uuid
  menuItemId        String     @map("menu_item_id") @db.Uuid
  variantId         String?    @map("variant_id") @db.Uuid
  nameSnapshot      String     @map("name_snapshot") @db.VarChar(150)
  unitPrice         Decimal    @map("unit_price") @db.Decimal(12, 2)
  quantity          Int        @db.SmallInt
  modifiersSnapshot Json       @default("[]") @map("modifiers_snapshot")
  lineTotal         Decimal    @map("line_total") @db.Decimal(12, 2)
  status            ItemStatus @default(PENDING)
  instructions      String?    @db.Text
  acceptedAt        DateTime?  @map("accepted_at") @db.Timestamptz
  readyAt           DateTime?  @map("ready_at") @db.Timestamptz
  servedAt          DateTime?  @map("served_at") @db.Timestamptz
  cancelReason      String?    @map("cancel_reason") @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, acceptedAt])
  @@map("order_items")
}

model Bill {
  id            String     @id @default(uuid()) @db.Uuid
  sessionId     String     @unique @map("session_id") @db.Uuid
  subtotal      Decimal    @db.Decimal(12, 2)
  taxTotal      Decimal    @map("tax_total") @db.Decimal(12, 2)
  serviceCharge Decimal    @default(0) @map("service_charge") @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @map("discount_total") @db.Decimal(12, 2)
  tip           Decimal    @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal    @map("grand_total") @db.Decimal(12, 2)
  amountPaid    Decimal    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status        BillStatus @default(OPEN)
  invoiceNo     String     @unique @map("invoice_no") @db.VarChar(30)
  generatedAt   DateTime   @default(now()) @map("generated_at") @db.Timestamptz
  paidAt        DateTime?  @map("paid_at") @db.Timestamptz

  session  TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("bills")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  billId            String        @map("bill_id") @db.Uuid
  method            PaymentMethod
  provider          String        @default("razorpay") @db.VarChar(30)
  providerOrderId   String?       @map("provider_order_id") @db.VarChar(80)
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(80)
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(CREATED)
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(80)
  receivedByUserId  String?       @map("received_by_user_id") @db.Uuid
  rawPayload        Json?         @map("raw_payload")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz

  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([paidAt])
  @@map("payments")
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  reason      String   @db.Text
  approvedBy  String   @map("approved_by") @db.Uuid
  status      String   @default("SUCCESS") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment  Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  approver User    @relation("RefundsApproved", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@map("refunds")
}

model TableAlert {
  id             String      @id @default(uuid()) @db.Uuid
  restaurantId   String      @map("restaurant_id") @db.Uuid
  tableId        String      @map("table_id") @db.Uuid
  sessionId      String?     @map("session_id") @db.Uuid
  type           AlertType
  severity       Int         @default(1) @db.SmallInt // 1=info, 2=warning, 3=critical
  message        String      @db.Text
  raisedBy       ActorType   @map("raised_by")
  status         AlertStatus @default(OPEN)
  assignedTo     String?     @map("assigned_to") @db.Uuid
  raisedAt       DateTime    @default(now()) @map("raised_at") @db.Timestamptz
  acknowledgedAt DateTime?   @map("acknowledged_at") @db.Timestamptz
  resolvedAt     DateTime?   @map("resolved_at") @db.Timestamptz
  escalated      Boolean     @default(false)

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  session    TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignee   User?         @relation("AssignedAlerts", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, raisedAt])
  @@map("table_alerts")
}

model CleaningTask {
  id          String     @id @default(uuid()) @db.Uuid
  tableId     String     @map("table_id") @db.Uuid
  sessionId   String?    @map("session_id") @db.Uuid
  status      TaskStatus @default(PENDING)
  assignedTo  String?    @map("assigned_to") @db.Uuid
  priority    Int        @default(1) @db.SmallInt // 1=normal, 2=boosted/reserved soon
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  startedAt   DateTime?  @map("started_at") @db.Timestamptz
  completedAt DateTime?  @map("completed_at") @db.Timestamptz
  notes       String?    @db.Text

  table    Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  session  TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignee User?         @relation("AssignedCleaningTasks", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("cleaning_tasks")
}

model TableStatusLog {
  id         BigInt      @id @default(autoincrement())
  tableId    String      @map("table_id") @db.Uuid
  fromStatus TableStatus @map("from_status")
  toStatus   TableStatus @map("to_status")
  reason     String      @db.VarChar(80)
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@map("table_status_logs")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  restaurantId String   @map("restaurant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(60)
  entity       String   @db.VarChar(60)
  entityId     String?  @map("entity_id") @db.Uuid
  diff         Json?
  ip           String?  @db.Text
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  rating    Int      @db.SmallInt // 1 to 5
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Reservation {
  id          String   @id @default(uuid()) @db.Uuid
  tableId     String?  @map("table_id") @db.Uuid
  name        String   @db.VarChar(120)
  phone       String   @db.VarChar(20)
  partySize   Int      @map("party_size") @db.SmallInt
  reservedFor DateTime @map("reserved_for") @db.Timestamptz
  status      String   @default("BOOKED") @db.VarChar(20) // BOOKED, SEATED, NO_SHOW, CANCELLED

  table Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@map("reservations")
}

model WaitlistEntry {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  phone     String    @db.VarChar(20)
  partySize Int       @map("party_size") @db.SmallInt
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz
  seatedAt  DateTime? @map("seated_at") @db.Timestamptz
  status    String    @default("WAITING") @db.VarChar(20) // WAITING, NOTIFIED, SEATED, LEFT

  @@map("waitlist_entries")
}

// ----------------------------------------------------
// PHASE 2: AI CAMERA TABLES
// ----------------------------------------------------

model Camera {
  id                 String   @id @default(uuid()) @db.Uuid
  restaurantId       String   @map("restaurant_id") @db.Uuid
  floorId            String   @map("floor_id") @db.Uuid
  name               String   @db.VarChar(80)
  streamUrlEncrypted String   @map("stream_url_encrypted") @db.Text
  status             String   @default("OFFLINE") @db.VarChar(20)
  lastSeenAt         DateTime? @map("last_seen_at") @db.Timestamptz

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  floor      Floor             @relation(fields: [floorId], references: [id], onDelete: Cascade)
  zones      CameraTableZone[]
  events     VisionEvent[]

  @@map("cameras")
}

model CameraTableZone {
  id       String @id @default(uuid()) @db.Uuid
  cameraId String @map("camera_id") @db.Uuid
  tableId  String @map("table_id") @db.Uuid
  polygon  Json   // List of normalized { x, y } coordinates

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  table  Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("camera_table_zones")
}

model VisionEvent {
  id          BigInt   @id @default(autoincrement())
  cameraId    String   @map("camera_id") @db.Uuid
  tableId     String?  @map("table_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(40)
  personCount Int?     @map("person_count") @db.SmallInt
  confidence  Decimal  @db.Decimal(4, 3)
  applied     Boolean  @default(false)
  snapshotUrl String?  @map("snapshot_url") @db.Text
  detectedAt  DateTime @default(now()) @map("detected_at") @db.Timestamptz

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@map("vision_events")
}

