# Database Configuration (PostgreSQL 15+ / Neon Cloud)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@host-pooler/database?sslmode=require"

# Redis Configuration (BullMQ & Realtime - Upstash / Redis 7)
REDIS_URL="rediss://default:password@host:port"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS=true

# API & Server Configuration
PORT=4000
NODE_ENV="development"
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="srms_super_secret_access_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="srms_super_secret_refresh_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"
GUEST_SESSION_SECRET="srms_guest_session_secret_change_in_production"
GUEST_SESSION_EXPIRES_IN="6h"

# Razorpay Configuration (Sandbox / Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Frontend URLs
GUEST_APP_URL="http://localhost:3000"
STAFF_APP_URL="http://localhost:3001"

